# Phone HTTPS tunnel (cloudflared)
NEXT_PUBLIC_PHONE_URL=https://your-tunnel.trycloudflare.com

# Supabase connection settings for the upcoming individual-account integration.
# These public settings alone do not enable Supabase authentication yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public deployments must set both secrets to randomly generated values of at
# least 32 characters. Example: openssl rand -base64 32
CARESIGNAL_APP_PASSWORD=
CARESIGNAL_MCP_TOKEN=
ALEXA_SKILL_ID=

# Ring Developer Playground — https://developer.amazon.com/ring/console/playground
# Generate Token (~30 min). Never commit the real token.
# Or paste live in the app: You → Setup (no restart) via /api/ring/token
RING_ACCESS_TOKEN=

# Optional: pin a device id from GET /v1/devices
# RING_DEVICE_ID=
# Optional trusted HTTPS origin when a local reverse proxy hides the public host.
# Example: https://your-current-tunnel.trycloudflare.com (no trailing path).
CARESIGNAL_PUBLIC_ORIGIN=

# Temporary tunnel demos only: disables shared caregiver password checks while
# running `next dev`. Ignored in production, including Netlify. Keep the URL
# private and turn this off after testing; camera/care endpoints are accessible
# to anyone who has the tunnel URL while it is enabled.
CARESIGNAL_TEMPORARY_CAMERA_DEMO=false
